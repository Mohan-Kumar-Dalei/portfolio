# Copy to backend/.env for local runs. On Vercel, add the same keys under
# Project → Settings → Environment Variables.

# --- Database (MongoDB Atlas for Vercel; localhost only works locally) ---
MONGO_URL=
DB_NAME=portfolio

# --- Server (local only; Vercel ignores PORT) ---
PORT=5001
NODE_ENV=production
# Comma-separated allowed origins, or * for any
CORS_ORIGIN=https://mohankumardalei.apex-ui.in,https://mohankumardalei.vercel.app

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Seeded admin account ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- AI chatbot (SARHA) & blog writer ---
# Defaults only: the key and model can be set (and tested) in Admin → Settings → AI.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional, comma-separated models tried when the main one is busy
GEMINI_FALLBACK_MODELS=
