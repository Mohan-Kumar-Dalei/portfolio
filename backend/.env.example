# Copy to backend/.env for local runs. On Vercel, add the same keys under
# Project → Settings → Environment Variables.

# --- Database (MongoDB Atlas for Vercel; localhost only works locally) ---
MONGO_URL=
DB_NAME=portfolio

# --- Server (local only; Vercel ignores PORT) ---
PORT=5001
NODE_ENV=production
# Comma-separated allowed origins, or * for any (same-origin on Vercel)
CORS_ORIGIN=*

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Seeded admin account ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- AI chatbot (Nova) ---
GEMINI_API_KEY=
GEMINI_MODEL=
